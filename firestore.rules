rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // NEW: sign-in provider "anonymous" = the public LINE OA self-registration page
    // (/line/register-parent). Anonymous sessions must never get the same broad
    // isAuthenticated() access real staff logins get — every rule below that could
    // otherwise match an anonymous session excludes it explicitly.
    function isAnonymousUser() {
      return isAuthenticated() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isRealAuth() {
      return isAuthenticated() && !isAnonymousUser();
    }

    // Only the exact fields the LINE parent-registration form writes to a student doc.
    function isAnonymousLineParentUpdate() {
      return isAnonymousUser() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'parentLineUserIds', 'parentLineRegistrations', 'parentLineRegistrationContexts',
        'guardianFirstName', 'guardianLastName', 'guardianPhone', 'guardianRelationship',
        'lineRegistrationReviewRequired', 'lineRegistrationReviewReason', 'lineRegistrationReviewResolvedAt'
      ]);
    }

    // Only the exact field the LINE teacher-registration form writes to a teacher doc.
    function isAnonymousLineTeacherUpdate() {
      return isAnonymousUser() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lineUserId']);
    }

    // NEW: อ่าน role ของผู้ใช้ที่ล็อกอินอยู่ จาก users/{uid} (role อาจเป็น string หรือ array)
    function hasRole(role) {
      let userRole = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return userRole == role || (userRole is list && role in userRole);
    }

    // NEW
    function isSuperAdmin() {
      return isAuthenticated() && hasRole('super_admin');
    }

    // NEW
    function isSchoolAdmin() {
      return isAuthenticated() && hasRole('school_admin');
    }

    // NEW: ห้องแชทฝ่ายงาน (dept-academic ฯลฯ) มี id ตายตัวที่ทุกคนรู้อยู่แล้วจากซอร์สโค้ด (ต่างจาก
    // parent-*/group-*/student-* ที่ id เดายากและใช้ความเดายากนั้นเป็นตัวคุมสิทธิ์แทน) จึงต้องพิสูจน์
    // ตัวตนจริงจากรายชื่อสมาชิก memberUids — ถ้ายังไม่มี field นี้เลย (ห้องเก่ายังไม่ผ่านการเพิ่มสมาชิก
    // ใหม่) get().data.memberUids จะเป็น null และ "uid in null" จะเป็นเท็จเสมอ = ยังไม่มีใครเป็นสมาชิก
    // เลยจนกว่าจะมีคนถูกเพิ่มเข้ามาจริง ตรงตามที่ต้องการ (ห้องเดิมเริ่มว่างเปล่า ต้องเพิ่มคนใหม่ทั้งหมด)
    function isDeptChatMember(schoolId, roomId) {
      return isRealAuth()
        && exists(/databases/$(database)/documents/school-settings/$(schoolId)/chatRooms/$(roomId))
        && request.auth.uid in get(/databases/$(database)/documents/school-settings/$(schoolId)/chatRooms/$(roomId)).data.memberUids;
    }

    // 1. School Settings - Root Access
    match /school-settings/{schoolId} {
      allow read: if true;
      allow write: if isRealAuth();

      // NEW: License/MA/สัญญา - อ่าน/เขียนได้เฉพาะ Owner (super_admin) เท่านั้น
      match /summaries/license {
        allow read, write: if isSuperAdmin();
      }

      match /students/{studentDocId} {
        allow get: if true;
        // NEW: list is needed by the public LINE registration page to look up a
        // student by studentId while signed in anonymously — same list access
        // any real staff login already had.
        allow list: if isAuthenticated();
        allow create, delete: if isRealAuth();
        allow update: if isRealAuth() || isAnonymousLineParentUpdate();

        match /{studentSubPath=**} {
          allow read: if true;
          allow write: if isRealAuth();
        }
      }

      // NEW: every match below this point requires isRealAuth() rather than plain
      // isAuthenticated() — none of them are needed by the anonymous LINE
      // registration flow, which only ever touches the students/teachers rules
      // above. Firestore ORs all matching rule blocks together, so leaving any of
      // these on isAuthenticated() would have re-opened the door to anonymous
      // sessions regardless of how narrowly students/teachers were scoped.
      match /main_calendar/{calendarId} {
        allow read: if true;
        allow write: if isRealAuth();
      }

      match /courses/{courseId} {
        allow read: if true;
        allow write: if isRealAuth();

        match /{courseSubPath=**} {
          allow read: if isAuthenticated();
          allow write: if isRealAuth();
        }
      }

      match /schedules/{scheduleId} {
        allow read: if true;
        allow write: if isRealAuth();
      }

      match /course_assignments/{assignmentId} {
        allow read: if true;
        allow write: if isRealAuth();
      }

      match /special-periods/{periodId} {
        allow read: if true;
        allow write: if isRealAuth();
      }

      match /configs/{configId} {
        allow get: if configId == "club_settings" || configId == "schedule_settings" || configId == "remediation_settings" || isRealAuth();
        allow list: if isRealAuth();
        allow write: if isRealAuth();
      }

      match /clubs/{clubId} {
        allow read: if true;
        allow write: if isRealAuth();

        match /members/{studentDocId} {
          allow get: if true;
          // NEW: ระบบแก้ 0/ร/มส/มผ (นักเรียนยื่นคำร้องเองแบบ anonymous auth) อ่าน "สมาชิกชุมนุม legacy"
          // ด้วย getDocs(collection(...)) (list query) เหมือน evaluations ด้านล่าง — เดิมยังค้างที่
          // isRealAuth() ทำให้นักเรียน (anonymous) โดน Missing or insufficient permissions
          allow list: if isAuthenticated();
          allow write: if isRealAuth();
        }

        // NEW: ระบบแก้ 0/ร/มส/มผ อ่านผลประเมิน "มผ" ของชุมนุมด้วย getDocs(collection(...)) (list query) —
        // subcollection ไม่ได้รับ rule จาก parent doc ด้านบนอัตโนมัติ ต้องมี match ของตัวเอง (เหตุผลเดียวกับ
        // members ด้านบน และ learner-activities/{id}/{subPath=**} ด้านล่าง)
        match /evaluations/{evalId} {
          allow read: if isAuthenticated();
          allow write: if isRealAuth();
        }
      }

      match /club_requests/{requestId} {
        allow create: if true;
        allow get, list, update, delete: if isRealAuth();
      }

      // FIX: recursive wildcard catch-all below only grants `get`, never `list`.
      // Any collection queried via getDocs/onSnapshot(query)/collectionGroup needs
      // its own explicit match here to support `list`.
      match /activities/{activityId} {
        allow read, write: if isRealAuth();
      }
      match /subject_groups/{groupId} {
        allow read, write: if isRealAuth();
      }
      match /director_assignments/{docId} {
        allow read, write: if isRealAuth();
      }
      match /enrollments/{docId} {
        allow read: if isAuthenticated();
        allow write: if isRealAuth();
      }
      // NEW: ระบบยื่นคำร้องขอแก้ 0/ร/มส/มผ — ต้องมี rule ของตัวเองแยกจาก catch-all
      // (เหตุผลเดียวกับ activities/subject_groups/ฯลฯ ด้านบน: catch-all รองรับแค่ get ไม่รองรับ list)
      // ไม่จำกัด role เฉพาะ เพราะทั้งนักเรียน (ยื่นคำร้อง), ครู (บันทึกผล), และฝ่ายวิชาการ (ภาพรวม) ต้องอ่าน/เขียนได้
      match /remediation_requests/{requestId} {
        allow read, write: if isAuthenticated();
      }
      // NEW: ผลประเมินกิจกรรมแนะแนว (guidance) — ระบบแก้ 0/ร/มส/มผ อ่านทั้ง collection ด้วย
      // getDocs(collection(...)) (list query) เพื่อหาคนที่ "ไม่ผ่าน" ทั้งโรงเรียน จึงต้องมี rule ของตัวเอง
      // แยกจาก catch-all เหมือนเหตุผลเดียวกับ remediation_requests/clubs/learner-activities ด้านบน
      match /guidance-evaluations/{docId} {
        allow read: if isAuthenticated();
        allow write: if isRealAuth();
      }
      match /learner-activities/{docId} {
        allow read: if isAuthenticated();
        allow write: if isRealAuth();

        // Subcollections (members, attendance, ...) need their own explicit rule —
        // the parent-doc rule above does not cascade to them, so queries like
        // learner-activities/{id}/members were being denied with "Missing or
        // insufficient permissions" even for authenticated teachers.
        match /{subPath=**} {
          allow read: if isAuthenticated();
          allow write: if isRealAuth();
        }
      }
      match /manual_substitute_requests/{docId} {
        allow read, write: if isRealAuth();
      }
      match /news/{docId} {
        allow read, write: if isRealAuth();
      }
      // NEW: e-Saraban / งานธุรการ — เอกสารลงรับ+ประทับตรา (GeneralAffairsPage,
      // DirectorAssignmentPage, AssignedWorkPage). Explicit rule instead of relying
      // on the {allSubcollections=**} catch-all below, to avoid any ambiguity.
      match /stampedDocuments/{docId} {
        allow read, write: if isRealAuth();
      }
      // NEW: ทะเบียนหนังสือ (DocumentRegistryPage) — หนังสือส่ง / คำสั่ง / ประกาศ / หนังสือรับรอง
      match /sentDocuments/{docId} {
        allow read, write: if isRealAuth();
      }
      match /orders/{docId} {
        allow read, write: if isRealAuth();
      }
      match /announcements/{docId} {
        allow read, write: if isRealAuth();
      }
      match /certificates/{docId} {
        allow read, write: if isRealAuth();
      }
      match /memos/{docId} {
        allow read, write: if isRealAuth();
      }
      match /honorCertificates/{docId} {
        allow read, write: if isRealAuth();
      }
      match /notifications/{notificationId} {
        allow read, write: if isRealAuth();
      }
      // NEW: ระบบแชท (ChatListPage/ChatRoomPage) — ห้องแชทหลักโรงเรียน/ฝ่ายงาน เปิดให้บุคลากรจริง
      // (isRealAuth) เท่านั้น ส่วนห้อง "parent-{studentId}" ต้องเปิดให้ผู้ปกครอง (anonymous auth
      // ผ่าน local session ตาม LoginPage.tsx) เข้าอ่าน/เขียนได้ด้วย — ผู้ปกครองไม่มี uid คงที่ให้
      // เช็คเป็นรายคน จึงอิงตามแพทเทิร์นเดียวกับ isAnonymousLineParentUpdate() ด้านบน คือเชื่อว่า
      // studentId ที่เป็นส่วนหนึ่งของ roomId (Firestore auto-id 20 ตัวอักษร) เดายากพอที่จะใช้แทน
      // การพิสูจน์ตัวตนแบบเข้มงวด เหมือนกับ student-lookups/{hashedId} ที่ใช้หลักการเดียวกัน
      //
      // NEW: ห้อง "student-direct-{teacherUid}_{studentId}" (แชทครู-นักเรียนรายบุคคล) ใช้หลักการ
      // เดียวกับ parent-* คือเปิดให้ anonymous (นักเรียน) เข้าอ่าน/สร้าง/แก้ไขได้ แต่บังคับว่า
      // create/update จาก anonymous ต้องตั้ง status เป็น 'pending' เท่านั้น (ขอ/ขอใหม่ได้ อนุมัติเองไม่ได้)
      // ส่วนการอนุมัติ/ปฏิเสธจริง (เปลี่ยนเป็น approved/rejected) ต้องเป็น isRealAuth (ครู) เท่านั้น
      //
      // NEW: ห้อง "student-homeroom-{studentId}" (แชทครูประจำชั้น ↔ ตัวนักเรียนเอง) เปิดคุยได้เลย
      // ไม่ต้องขออนุญาต ใช้หลักการเดียวกับ parent-* ทุกอย่าง (คู่กันแค่ต่างฝั่งเข้า)
      //
      // NEW: ห้อง "group-{randomId}" (กลุ่มแชทที่ครูสร้างเอง เช่น กลุ่มผู้ปกครองของห้องเรียน) — สร้าง/
      // เพิ่ม-ลบสมาชิก (memberStudentIds) ได้เฉพาะ isRealAuth() (ครู) เท่านั้น ผู้ปกครอง (anonymous)
      // อ่าน+ส่งข้อความได้ แต่แก้ไขเอกสารห้องได้แค่ field ที่เกี่ยวกับการส่งข้อความ/มาร์คอ่านแล้วเท่านั้น
      // ห้ามแตะ memberStudentIds/groupName/createdByUid ป้องกันไม่ให้ผู้ปกครองปลอมแปลงสมาชิกกลุ่ม
      //
      // NEW: ห้อง "dept-*" (แชทฝ่ายงาน) เปลี่ยนจากเปิดกว้างทุกคน มาเป็นจำกัดสิทธิ์ตาม memberUids —
      // เจ้าหน้าที่ "ทุกคน" เพิ่มเพื่อนร่วมงาน (หรือตัวเอง) เข้าห้องไหนก็ได้โดยไม่ต้องเป็นสมาชิกก่อน (ตั้งใจ
      // เปิดกว้างแบบนี้) แต่การอ่าน/ส่งข้อความจริงต้องเป็นสมาชิก (อยู่ใน memberUids) แล้วเท่านั้น
      match /chatRooms/{roomId} {
        allow get: if (isRealAuth() && (!roomId.matches('dept-.*') || isDeptChatMember(schoolId, roomId)))
          || (isAnonymousUser() && (roomId.matches('parent-.*') || roomId.matches('student-homeroom-.*') || roomId.matches('student-direct-.*') || roomId.matches('group-.*')));
        allow list: if isRealAuth()
          || (isAnonymousUser() && resource.data.type == 'student-direct');
        allow create, update: if isRealAuth()
          || (isAnonymousUser() && (roomId.matches('parent-.*') || roomId.matches('student-homeroom-.*')))
          || (isAnonymousUser() && roomId.matches('student-direct-.*') && request.resource.data.status == 'pending')
          // NEW: ห้อง student-direct ที่ครูอนุมัติแล้ว (status == 'approved') นักเรียน (anonymous)
          // ต้องเขียน field "readBy" (มาร์คว่าอ่านแล้ว สำหรับ badge จำนวนแชทที่ยังไม่อ่าน) ได้ด้วย
          // แต่ห้ามแตะ field อื่น (โดยเฉพาะ status) — จำกัดด้วย affectedKeys().hasOnly(['readBy'])
          || (isAnonymousUser() && roomId.matches('student-direct-.*')
              && resource.data.status == 'approved'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']))
          || (isAnonymousUser() && roomId.matches('group-.*')
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageText', 'lastMessageAt', 'lastMessageSenderUid', 'readBy']));
        allow delete: if isRealAuth();

        match /messages/{messageId} {
          allow read: if (isRealAuth() && (!roomId.matches('dept-.*') || isDeptChatMember(schoolId, roomId)))
            || (isAnonymousUser() && (roomId.matches('parent-.*') || roomId.matches('student-homeroom-.*') || roomId.matches('student-direct-.*') || roomId.matches('group-.*')));
          // NEW: นอกจากข้อความตัวหนังสือ (type == 'text', เดิม) ยังรองรับสติกเกอร์ (stickerId ชี้ไป
          // ไฟล์ภาพที่ bundle มากับแอปเอง ไม่ใช่ URL ที่ผู้ใช้กำหนดเอง) และ GIF (gifUrl มาจาก Klipy
          // API ฝั่ง client — บังคับแค่ https และลงท้าย .gif/.webp กันไม่ให้ฝัง URL รูปภาพ/tracking
          // pixel โดเมนอื่นมาแอบอ้างเป็น "GIF" ได้ ไม่ผูกกับโดเมน CDN ตายตัวเพราะยืนยันไม่ได้ชัดเจน)
          //
          // NEW: type == 'image' (ถ่ายรูปจากกล้องในแชท) imageUrl ต้องเป็นลิงก์จาก Firebase Storage
          // เท่านั้น (บังคับโดเมน firebasestorage.googleapis.com) storagePath เก็บไว้ให้ Cloud Function
          // cleanupExpiredChatImages ใช้ลบไฟล์จริงออกจาก Storage ตอนครบอายุ ~1 ปีการศึกษา
          //
          // NEW: type == 'document' (ส่ง/แชร์เอกสาร PDF ที่มีอยู่ในระบบ) อ้างอิง pdfUrl เดิม ไม่ต้องอัปโหลดซ้ำ
          allow create: if (
              (isRealAuth() && (!roomId.matches('dept-.*') || isDeptChatMember(schoolId, roomId) || request.resource.data.type == 'document'))
              || (isAnonymousUser() && (roomId.matches('parent-.*') || roomId.matches('student-homeroom-.*') || roomId.matches('student-direct-.*') || roomId.matches('group-.*')))
            )
            && request.resource.data.keys().hasAll(['senderUid', 'senderName', 'senderRole', 'createdAt'])
            && (
              (
                request.resource.data.get('type', 'text') == 'text'
                && request.resource.data.text is string
                && request.resource.data.text.size() > 0
                && request.resource.data.text.size() <= 2000
              )
              || (
                request.resource.data.type == 'sticker'
                && request.resource.data.stickerId is string
                && request.resource.data.stickerId.size() > 0
                && request.resource.data.stickerId.size() <= 50
              )
              || (
                request.resource.data.type == 'gif'
                && request.resource.data.gifUrl is string
                && request.resource.data.gifUrl.size() <= 500
                && request.resource.data.gifUrl.matches('https://.+[.](gif|webp)(\\?.*)?')
              )
              || (
                request.resource.data.type == 'image'
                && request.resource.data.imageUrl is string
                && request.resource.data.imageUrl.size() <= 500
                && request.resource.data.imageUrl.matches('https://firebasestorage[.]googleapis[.]com/.*')
                && request.resource.data.storagePath is string
                && request.resource.data.storagePath.size() > 0
                && request.resource.data.storagePath.size() <= 300
              )
              || (
                request.resource.data.type == 'document'
                && request.resource.data.pdfUrl is string
                && request.resource.data.pdfUrl.size() > 0
                && request.resource.data.pdfUrl.size() <= 3000
                && request.resource.data.documentName is string
                && request.resource.data.documentName.size() > 0
                && request.resource.data.documentName.size() <= 1000
              )
              || (
                request.resource.data.type == 'attendance'
                && request.resource.data.attendance is map
              )
            )
            // ห้อง student-direct ต้องรอครูอนุมัติ (status == 'approved') ก่อนถึงจะส่งข้อความได้จริง
            && (
              !roomId.matches('student-direct-.*')
              || get(/databases/$(database)/documents/school-settings/$(schoolId)/chatRooms/$(roomId)).data.status == 'approved'
            );
          allow update, delete: if false;
        }
      }

      // สถานะออนไลน์ (Presence) ของครู นักเรียน และผู้ปกครอง
      match /presence/{userId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }

      match /physical-rooms/{docId} {
        // NEW: นักเรียน/ผู้ปกครอง (anonymous auth) ต้องอ่านชื่อห้องเรียนเพื่อแสดงตารางสอนที่
        // /academic/my-schedule (MySchedulePage.tsx) — เดิม isRealAuth() กันนักเรียนออกไปด้วย ทำให้
        // Promise.all ทั้งก้อนล้มเหลวและตารางสอนไม่ขึ้นเลย เหมือน schedules/courses/clubs ด้านบนที่
        // เปิด read ให้ทุกคนอยู่แล้ว
        allow read: if true;
        allow write: if isRealAuth();
      }
      match /special-period-attendance/{docId} {
        allow read, write: if isRealAuth();
      }
      match /special_programs/{docId} {
        allow read, write: if isRealAuth();
      }
      match /substitutions/{docId} {
        allow read, write: if isRealAuth();
      }
      match /leave_summary/{docId} {
        allow read, write: if isRealAuth();
      }
      match /desired-characteristics/{docId} {
        allow read, write: if isRealAuth();
      }
      match /reading-thinking-writing/{docId} {
        allow read, write: if isRealAuth();
      }
      match /screening_assessments/{docId} {
        allow read, write: if isRealAuth();
      }
      match /sdq-assessments/{docId} {
        allow read, write: if isRealAuth();
      }

      // FIX: teachers/{teacherId}/{attendance,leave_summary,travel_summary} are
      // queried via getDocs(collection(...)) elsewhere in the app (ViewTeacherPage,
      // HomePage, TeacherAttendanceSummaryPage, LeaveApprovalPage, etc.) — same
      // list-vs-get issue as above, one level deeper under `teachers`.
      match /teachers/{teacherId} {
        match /attendance/{attendanceId} {
          allow read, write: if isRealAuth();
        }
        match /leave_summary/{leaveId} {
          allow read, write: if isRealAuth();
        }
        match /travel_summary/{travelId} {
          allow read, write: if isRealAuth();
        }
      }

      // FIX: PermissionContext.tsx reads this with getDocs(collection(...)) (a `list`
      // query) to load school-specific route permission overrides — the catch-all
      // wildcard below only grants `get`, so it needs its own explicit match.
      match /route_permissions/{routeKey} {
        allow read: if isRealAuth();
        allow write: if isRealAuth();
      }

      // NEW: ยกเว้น summaries/license ออกจาก catch-all นี้ (ไม่งั้นจะ OR ทับ rule เฉพาะด้านบน)
      // Anonymous sessions are excluded here too — every collection an anonymous
      // LINE-registration session actually needs has its own explicit, narrowly
      // scoped rule above; this catch-all is for real staff logins only.
      match /{allSubcollections=**} {
        allow read: if isAuthenticated()
          && !(allSubcollections.size() >= 2 && allSubcollections[0] == 'summaries' && allSubcollections[1] == 'license');
        allow write: if isRealAuth()
          && !(allSubcollections.size() >= 2 && allSubcollections[0] == 'summaries' && allSubcollections[1] == 'license');
      }
    }

    // 2. Student Hashed Lookups
    match /student-lookups/{hashedId} {
      allow get: if true;
      allow list: if false;
      allow write: if isRealAuth();
    }

    // 3. Teachers Collection Group
    match /{path=**}/teachers/{teacherId} {
      allow read: if true;
      // NEW: anonymous (public LINE teacher-registration page) may only ever set
      // lineUserId on an existing teacher doc — never create/delete or touch any
      // other field.
      allow write: if isRealAuth() || isAnonymousLineTeacherUpdate();
    }

    // 3.5 FIX: collectionGroup() queries (across all schools) need their own
    // top-level match — the nested school-settings/{schoolId}/notifications
    // rule above only covers single-school-scoped queries, not collectionGroup.
    match /{path=**}/notifications/{notificationId} {
      allow read: if isRealAuth();
      allow write: if isRealAuth();
    }
    match /{path=**}/leave_summary/{docId} {
      allow read: if isRealAuth();
      allow write: if isRealAuth();
    }
    match /{path=**}/travel_summary/{docId} {
      allow read: if isRealAuth();
      allow write: if isRealAuth();
    }
    // FIX: ClassroomAttendanceAuditPage and several other pages (AttendanceSummaryPage,
    // HistoricalClassroomAttendancePage, GuidanceAttendancePage, SpecialPeriodAttendancePage,
    // etc.) run collectionGroup(db, 'ClassroomAttendance') queries — same list-vs-collectionGroup
    // gap as notifications/leave_summary above.
    match /{path=**}/ClassroomAttendance/{docId} {
      allow read: if isRealAuth();
      allow write: if isRealAuth();
    }

    // 4. Slugs
    match /slugs/{slug} {
      allow read: if true;
      allow write: if isRealAuth();
    }

    // 4.1 FIX: same list-vs-get gap as above but for the global route_permissions
    // collection (PermissionContext.tsx: getDocs(collection(db, 'route_permissions'))).
    // Global overrides are system-wide, so writes are restricted to super admin.
    match /route_permissions/{routeKey} {
      allow read: if isRealAuth();
      allow write: if isSuperAdmin();
    }

    // 4.2 System manuals (คู่มือการใช้ระบบ) - เอกสารกลาง ใช้ร่วมกันทุกโรงเรียน
    // อ่านได้ทุกคนที่ล็อกอิน แก้ไข/เพิ่ม/ลบได้เฉพาะ Super Admin
    match /system-manuals/{manualId} {
      allow read: if isRealAuth();
      allow write: if isSuperAdmin();
    }

    // 4.3 AI Assistant config — เปิด/ปิดผู้ช่วย AI แบบ rule-based ในระบบ (ไม่มี API key/ความลับใดๆ
    // เก็บอยู่แล้ว จึงอ่านได้ทุกคนที่ล็อกอินจริง เพื่อให้ปุ่มลอย AI รู้ว่าต้องแสดงหรือไม่ — แก้ไขได้
    // เฉพาะ Super Admin เท่านั้น)
    match /ai_config/{configId} {
      allow read: if isRealAuth();
      allow write: if isSuperAdmin();
    }

    // NEW: 4.5 Users - ป้องกัน privilege escalation
    // Anonymous sessions never legitimately touch users/** — the LINE teacher
    // registration form's best-effort mirror write to users/{teacherUid} always
    // fails for them anyway since request.auth.uid (a random anonymous uid) can
    // never equal an existing teacher's real uid; that write is already wrapped
    // in a try/catch in LineRegisterPage.tsx and treated as non-fatal.
    match /users/{userId} {
      allow read: if isRealAuth();

      allow create: if isRealAuth() && (
        (request.auth.uid == userId && request.resource.data.role == 'teacher')
        || isSuperAdmin()
        || isSchoolAdmin()
      );

      allow update: if isRealAuth() && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
        || isSuperAdmin()
        || isSchoolAdmin()
      );

      allow delete: if isSuperAdmin();

      match /{userSubPath=**} {
        allow read, write: if isRealAuth() && (request.auth.uid == userId || isSuperAdmin());
      }
    }

    // 4.6 Consents — บันทึกการยอมรับนโยบายความเป็นส่วนตัว/ข้อกำหนดการใช้บริการ (ConsentGate.tsx)
    // เก็บ 1 เอกสารต่อ uid ทั้งผู้ใช้จริง (ครู/แอดมิน) และ anonymous session (นักเรียน/ผู้ปกครองที่
    // 4.5. PDPA/Terms Consent (ทั้งครู/แอดมินที่มีบัญชีจริง และนักเรียน/ผู้ปกครองที่
    // ล็อกอินผ่าน local session + signInAnonymously) — อนุญาตให้อ่านและบันทึกความยินยอม
    // ผูกตามตัวตนจริงและปีการศึกษา (student_*, parent_*, teacher_* หรือตาม uid)
    match /consents/{consentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        request.auth.uid == consentId ||
        consentId.matches('^student_.*') ||
        consentId.matches('^parent_.*') ||
        consentId.matches('^teacher_.*')
      );
    }

    // 5. Global fallback
    // NEW: กัน users/** ออก เพราะข้อ 4.5 คุมเองแล้ว — anonymous excluded entirely,
    // it has no legitimate reason to touch anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if isRealAuth() && document[0] != 'users';
    }
  }
}
